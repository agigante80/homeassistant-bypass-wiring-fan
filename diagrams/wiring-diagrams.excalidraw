      "text": "Wi-Fi Fan\nwith\nintegrated\nlight",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "jFZeFzqq3tekeY7piMF7B",
      "originalText": "Wi-Fi Fan with integrated light",
