      "updated": 1779348104141,
      "link": null,
      "locked": false,
      "text": "Wall switches still the original mechanical\nones. They no longer cut the fan's power,\ninstead they trigger Home Assistant. \n\nManual control via wall switch and remote\ncontrol via HA, both work in parallel.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wall switches still the original mechanical ones. They no longer cut the fan's power, instead they trigger Home Assistant. \n\nManual control via wall switch and remote control via HA, both work in parallel.",
      "autoResize": false,
      "lineHeight": 1.25
    },
