    },
    {
      "id": "SCpvK_Tjw4s8L9-Tv5rkz",
      "type": "text",
      "x": 543.3516805188277,
      "y": 1440.9295377038163,
      "width": 181.31918238993717,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 2072274128,
      "version": 181,
      "versionNonce": 1097559600,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1779114463826,
      "link": null,
      "locked": false,
      "text": "L and L are internally\nbridged. Live enters L\n(top), exits second L\nto permanently power\nthe fan canopy.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L and L are internally bridged. Live enters L (top), exits second L to permanently power the fan canopy.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "4sJsMbhE4_P9z_9HrH9hg",
      "type": "text",
      "x": 570.1702001225353,
      "y": 1352.604118656995,
      "width": 158.3399486950088,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 225330224,
      "version": 796,
      "versionNonce": 351804464,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779116247992,
      "link": null,
      "locked": false,
      "text": "L and L are\ninternally bridged.\nUsed in some\ninstalls to tap Live\nwithin the junction\nbox without an\nexternal wago. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L and L are internally bridged. Used in some installs to tap Live within the junction box without an external wago. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
